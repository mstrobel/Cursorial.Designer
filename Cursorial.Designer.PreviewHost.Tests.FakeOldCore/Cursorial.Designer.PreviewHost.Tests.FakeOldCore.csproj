<Project Sdk="Microsoft.NET.Sdk">

    <!--
        Test fixture: a Cursorial.Core imposter STAMPED OLDER than any real release (0.1.0.0).
        The launcher's version gate reads nothing but AssemblyName metadata — identity and
        version — so a blank assembly with the right name is a faithful stand-in for a genuinely
        old framework build, without needing one. The gate E2E points the launcher's user-dir
        argument at this project's output and asserts the bundled fallback plus its
        fallbackReason. Never referenced for compilation; the test project takes a
        build-ordering-only ProjectReference and bakes this output path in as AssemblyMetadata.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>Cursorial.Core</AssemblyName>
        <Version>0.1.0</Version>
        <AssemblyVersion>0.1.0.0</AssemblyVersion>
    </PropertyGroup>

</Project>
